# Copy to .env.local and fill in. Never commit .env.local.

# Sends contact-form letters to the email in lib/site-config.ts.
# Get one at https://resend.com/api-keys. Sign up with that same email:
# until you verify your own domain, Resend only delivers to it.
RESEND_API_KEY=

# The site's public address, used for canonical links, the sitemap and
# link previews. Example: https://jminallah.is-a.dev
NEXT_PUBLIC_SITE_URL=

# Optional. The code from Google Search Console's "HTML tag" verification
# (the content="..." value only), to prove you own the site.
GOOGLE_SITE_VERIFICATION=
